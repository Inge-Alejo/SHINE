# Configuración Apache / LiteSpeed - Latinoamérica Hosting Colombia
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Proteger archivos sensibles y bases de datos
    <FilesMatch "^(\.env|\.git|.*\.db|.*\.sqlite|.*\.sql)">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Cabeceras de seguridad
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
        Header set X-Frame-Options "SAMEORIGIN"
        Header set X-XSS-Protection "1; mode=block"
    </IfModule>

    # Compresión gzip para archivos estáticos y json
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE application/json text/html text/plain text/xml text/css application/javascript image/svg+xml
    </IfModule>
</IfModule>

