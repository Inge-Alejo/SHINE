# Configuración de Entorno para SHINE Fragancias
# Desarrollado para Latinoamérica Hosting Colombia (Plan H1)

# Tipo de base de datos: 'sqlite' (por defecto, portátil sin configuración previa) o 'mysql'
DB_TYPE=sqlite

# Configuración MySQL (completar solo si DB_TYPE=mysql en cPanel)
DB_HOST=localhost
DB_NAME=shine_fragancias
DB_USER=shine_user
DB_PASS=tu_clave_segura_mysql
DB_PORT=3306

# Clave secreta para tokens de autenticación del panel administrativo
ADMIN_JWT_SECRET=shine_super_secret_jwt_key_2026_colombia_latinoamerica_hosting

# Integración Inteligencia Artificial (opcional)
GEMINI_API_KEY=

# Número oficial de WhatsApp de SHINE Fragancias (código país + número, sin espacios ni símbolos)
WHATSAPP_NUMBER=573105964755

