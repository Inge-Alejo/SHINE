# ========================================================================
# SHINE Fragancias - Variables de Entorno (Producción Vercel & Local)
# ========================================================================
# 
# En Vercel:
# Configura estas variables en: Project Settings -> Environment Variables
#
# En Local:
# Copia este archivo a `.env.local` y asigna tus credenciales privadas.
# `.env.local` está protegido en .gitignore y NUNCA se sube a GitHub.
# ========================================================================

# 1. BASE DE DATOS EN LA NUBE (Vercel Postgres / Neon)
# Vercel la inyecta automáticamente al conectar Storage -> Postgres.
# Formato: postgres://default:[PASSWORD]@[HOST].postgres.vercel-storage.com/verceldb?sslmode=require
POSTGRES_URL="postgres://default:tu_password@ep-tu-proyecto.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require"

# 2. CREDENCIALES DEL PANEL ADMINISTRATIVO
# Define el usuario y contraseña maestra para administrar productos y tarifas.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="shine2026!"

# 3. FIRMA CRIPTOGRÁFICA DE SESIÓN (JWT)
# Clave aleatoria secreta para firmar los tokens de sesión del administrador.
JWT_SECRET="shine_super_secret_jwt_key_2026_colombia_production_99a8b7c6d5e4"

# 4. GOOGLE GEMINI API
# Obtenida gratuitamente en: https://aistudio.google.com/
# Permite enriquecer notas olfativas y automatizar la búsqueda de imágenes oficiales.
GEMINI_API_KEY="AIzaSyTuClaveDeGoogleGeminiAqui"

