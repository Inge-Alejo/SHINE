{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/backend/api/products.php", "destination": "/api/products" },
    { "source": "/backend/api/settings.php", "destination": "/api/settings" },
    { "source": "/backend/api/auth.php", "destination": "/api/auth" },
    { "source": "/backend/api/dashboard.php", "destination": "/api/dashboard" },
    { "source": "/backend/api/sheets_sync.php", "destination": "/api/sheets-sync" },
    { "source": "/backend/api/image_manager.php", "destination": "/api/image-manager" },
    { "source": "/backend/api/gemini_service.php", "destination": "/api/gemini" },
    { "source": "/api/products.php", "destination": "/api/products" },
    { "source": "/api/settings.php", "destination": "/api/settings" },
    { "source": "/api/auth.php", "destination": "/api/auth" },
    { "source": "/api/dashboard.php", "destination": "/api/dashboard" },
    { "source": "/api/sheets_sync.php", "destination": "/api/sheets-sync" },
    { "source": "/api/image_manager.php", "destination": "/api/image-manager" },
    { "source": "/api/gemini.php", "destination": "/api/gemini" },
    { "source": "/api/sheets-sync", "destination": "/api/sheets-sync" },
    { "source": "/api/image-manager", "destination": "/api/image-manager" },
    { "source": "/uploads/(.*)", "destination": "/uploads/$1" },
    { "source": "/((?!api|uploads|favicon|icons|data).*)", "destination": "/index.html" }
  ]
}

